# 复制为 .env 使用；.env 不提交 Git。所有项都有默认值，不配置也能在本机运行。

# 开发/演示数据库（本机 PostgreSQL 16，unix socket + peer 认证，系统用户 shao）
OPS_AGENT_DATABASE_URL=postgresql+psycopg://shao@/ops_agent_runtime?host=/var/run/postgresql

# 测试库（pytest 专用，与开发库物理隔离）
OPS_AGENT_TEST_DATABASE_URL=postgresql+psycopg://shao@/ops_agent_runtime_test?host=/var/run/postgresql

# M5 启用：任意 OpenAI 兼容 LLM（DeepSeek/智谱/Kimi/Qwen/Ollama 均可），不绑定厂商
# 例（DeepSeek）：
# OPS_AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# OPS_AGENT_LLM_API_KEY=sk-xxxx
# OPS_AGENT_LLM_MODEL=deepseek-chat
OPS_AGENT_LLM_BASE_URL=
OPS_AGENT_LLM_API_KEY=
OPS_AGENT_LLM_MODEL=
